# Instagram Hashtag Research Tool — systemd service
# Place in /etc/systemd/system/cicada-lead-app.service
# Then: sudo systemctl daemon-reload && sudo systemctl enable --now cicada-lead-app

[Unit]
Description=CICADA Instagram Hashtag Research Tool (Lead App)
After=network-online.target
Wants=network-online.target
# Browser automation needs xvfb if running headless on a headless Pi
Wants=xvfb-instagram.service
After=xvfb-instagram.service

[Service]
Type=simple
User=cicadaserver
Group=cicadaserver
WorkingDirectory=/opt/cicada-lead-app
# Keep HOME pointing at the user's home so .playwright-profile* resolve correctly.
Environment=HOME=/home/cicadaserver
Environment=NODE_ENV=production
# Use system chromium on Raspberry Pi ARM
Environment=PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Local Ollama on the Pi
Environment=OLLAMA_URL=http://127.0.0.1:11434
EnvironmentFile=/etc/cicada-lead-app.env

# Symlinks in ExecStartPre point to persistent profiles in the project dir
ExecStartPre=/bin/mkdir -p /opt/cicada-lead-app
ExecStartPre=/bin/ln -sfn /home/cicadaserver/instagram-hashtag-research-tool/.playwright-profile /opt/cicada-lead-app/.playwright-profile
ExecStartPre=/bin/ln -sfn /home/cicadaserver/instagram-hashtag-research-tool/.playwright-profile-maps /opt/cicada-lead-app/.playwright-profile-maps
ExecStartPre=/bin/ln -sfn /home/cicadaserver/instagram-hashtag-research-tool/.playwright-profile-facebook /opt/cicada-lead-app/.playwright-profile-facebook

ExecStart=/usr/bin/node /opt/cicada-lead-app/dist/server.js
Restart=on-failure
RestartSec=5

# Allow write access to the app dir and the persistent profile locations
ReadWritePaths=/opt/cicada-lead-app
ReadWritePaths=/home/cicadaserver/instagram-hashtag-research-tool

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
# /home is needed read-only to follow the profile symlinks; above ReadWritePaths grants write
# to the specific subdirs, so we keep ProtectHome off to allow that.

[Install]
WantedBy=multi-user.target
