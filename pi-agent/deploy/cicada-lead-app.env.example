# Required environment variables for cicada-lead-app (Pi production deployment)
# Copy this file to /etc/cicada-lead-app.env and fill in the values.
# On a fresh deploy this is done automatically if .env exists in the project dir.

# Neon PostgreSQL — connection string from your Neon dashboard (keep sslmode=require)
DATABASE_URL=

# Local Ollama on the Pi (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Groq API key (optional — only needed for cloud website analysis fallback)
GROQ_API_KEY=

# Pi sender handoff (optional — only needed to push leads to the Pi sender)
DM_SENDER_URL=
DM_SENDER_API_TOKEN=
DM_SENDER_TIMEOUT_MS=15000
